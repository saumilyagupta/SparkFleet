[Unit]
Description=Apache ZooKeeper for Spark master HA (managed by clusterctl)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{user}}
Environment=ZOO_LOG_DIR={{zookeeper_data}}/logs
ExecStart={{zookeeper_home}}/bin/zkServer.sh start-foreground {{zookeeper_home}}/conf/zoo.cfg
Restart=on-failure
# Same nodes run 24-core executors: keep ZooKeeper heartbeats on time.
CPUWeight=500
Nice=-5
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
