[Unit]
Description=Apache Spark standalone worker (managed by clusterctl)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{user}}
Environment=SPARK_HOME={{spark_home}}
Environment=SPARK_NO_DAEMONIZE=true
ExecStart={{spark_home}}/bin/spark-class org.apache.spark.deploy.worker.Worker --host {{host_ip}} --webui-port {{worker_ui_port}} {{spark_master_url}}
# Restart if the worker crashes. A deliberate 'systemctl stop' (failure demo) stays stopped.
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
# Stopping the worker also kills its executor JVMs (same cgroup): a real node loss.
KillMode=control-group

[Install]
WantedBy=multi-user.target
